# Squarely LAN Print Agent — sample env. Copy to .env and fill in.

# Supabase project URL (e.g. https://<ref>.supabase.co)
SUPABASE_URL=

# Anon (public) key — NEVER the service-role key. The agent signs in as a
# regular user so RLS continues to scope it to one merchant.
SUPABASE_ANON_KEY=

# Dedicated "printer agent" user in Supabase Auth. See README for setup.
AGENT_EMAIL=
AGENT_PASSWORD=

# Optional: comma-separated printer UUIDs to restrict this agent to. If omitted,
# the agent processes every LAN printer it can read under RLS.
# PRINTER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222

# Optional: how often to poll print_jobs (ms). Default 5000.
# POLL_INTERVAL_MS=5000
